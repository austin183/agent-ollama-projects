# SFTP user credentials (format: username:password:uid:gid)
# Password auth is kept for test-client; key-based auth used by restic containers
SFTP_USERS=CHANGE_ME:CHANGE_ME:1000:1000

# Restic backup password - CHANGE THIS to a strong password
# This password encrypts all backup data. Losing it means losing access to backups.
RESTIC_PASSWORD=ChangeMe123!

# SFTP password for test client connectivity tests
SFTP_PASSWORD=ChangeMe

# IMPORTANT: Before running, generate SSH keys for restic authentication:
#   mkdir -p ssh-config && ssh-keygen -t rsa -b 4096 -f ssh-config/id_rsa -N "" -q
