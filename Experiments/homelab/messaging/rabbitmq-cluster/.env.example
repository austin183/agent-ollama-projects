# Erlang cookie for RabbitMQ cluster authentication (must be identical across all nodes)
RABBITMQ_CLUSTER_COOKIE=CHANGE_ME

# Default RabbitMQ administrator credentials
RABBITMQ_DEFAULT_USER=CHANGE_ME
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# Flower monitoring dashboard Basic Auth (format: username:password)
FLOWER_BASIC_AUTH=CHANGE_ME
